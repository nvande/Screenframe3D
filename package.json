{
  "name": "screenframe3d",
  "version": "0.1.0",
  "description": "A JavaScript library for showcasing app screenshots in 3D device mockups",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.js"
    },
    "./poster": {
      "types": "./dist/poster.d.ts",
      "import": "./dist/poster.mjs",
      "require": "./dist/poster.js"
    }
  },
  "typesVersions": {
    "*": {
      "react": ["dist/react/index.d.ts"],
      "vite": ["dist/vite.d.ts"],
      "poster": ["dist/poster.d.ts"]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "build:pages": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "3d",
    "device",
    "mockup",
    "screenshot",
    "three.js"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "three": "^0.162.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.162.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^3.1.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.2",
    "typescript": "^4.9.5",
    "vite": "^4.5.2"
  }
}
